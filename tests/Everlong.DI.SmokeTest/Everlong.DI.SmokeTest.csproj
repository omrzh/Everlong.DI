<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack-level consumer smoke: consumes Everlong.DI as a real package (analyzers +
         buildTransitive targets + lib), NOT as a ProjectReference. Bump this version with
         every release; keep it in sync with EverlongDI.props. -->
    <PackageReference Include="Everlong.DI" Version="0.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

</Project>
