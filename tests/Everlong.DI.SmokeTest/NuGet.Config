<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Public-repo safe: only nuget.org is committed. After a release this verifies the
         published package. To smoke a not-yet-published nupkg (pre-release), pass a local
         folder feed per restore without touching this file:
         dotnet run -p:RestoreAdditionalProjectSources="<feed-path>" -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
